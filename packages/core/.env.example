# MODE: Prototype Mode | Live Mode
# USED BY API
# USED BY WORKER
# REDIS REQUIRED FOR QUEUE FEATURES
# POSTGRES REQUIRED FOR LIVE DATA
#
# NOTE:
# - Canonical template: repository root `.env.example`
# - This file mirrors core runtime expectations for package-local workflows.

# ============================================================
# REQUIRED FOR PROTOTYPE MODE AND LIVE MODE
# ============================================================
# MODE: Prototype Mode | Live Mode
# Source of truth for runtime behavior selection.
INTEGRATOR_MODE="Prototype Mode"
APP_ENV=development
DATABASE_URL=postgres://integration:integration@localhost:5432/integration
REDIS_URL=redis://localhost:6379

# ============================================================
# REQUIRED FOR LIVE MODE (RECOMMENDED IN PROTOTYPE MODE)
# ============================================================
JWT_SECRET=dev-only-jwt-secret-change-me
MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
MASTER_ENCRYPTION_KEY_VERSION=1
# PREVIOUS_MASTER_ENCRYPTION_KEYS=1:<oldKeyBase64>,2:<olderKeyBase64>

# ============================================================
# OPTIONAL IN PROTOTYPE MODE / LIVE MODE
# ============================================================
JWT_EXPIRES_IN=12h
API_PORT=4000
ADAPTER_MANIFESTS_DIR=
INTEGRATOR_QUEUE_DRIVER=bullmq
# QUEUE: Redis + BullMQ
# Incoming workflow trigger event queue key.
INTEGRATOR_EVENT_QUEUE_KEY=integration-events
# BullMQ Redis key prefix for queue internals.
INTEGRATOR_BULLMQ_PREFIX=integrator
# BullMQ worker tuning (incoming event transport only).
INTEGRATOR_BULLMQ_WORKER_CONCURRENCY=1
INTEGRATOR_BULLMQ_REMOVE_ON_COMPLETE_COUNT=1000
INTEGRATOR_BULLMQ_REMOVE_ON_FAIL_COUNT=2000
INTEGRATOR_BULLMQ_JOB_NAME=incoming-event

# Connection pool and client tuning (recommended for high-concurrency workloads)
DATABASE_POOL_MAX=50
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000
# DATABASE_POOL_STATEMENT_TIMEOUT_MS=30000
# DATABASE_POOL_QUERY_TIMEOUT_MS=30000
DATABASE_POOL_APP_NAME=integrator-engine
# DATABASE_POOL_SSL_MODE=require

REDIS_SOCKET_CONNECT_TIMEOUT_MS=5000
REDIS_SOCKET_KEEPALIVE_MS=5000
REDIS_PING_INTERVAL_MS=10000
REDIS_DISABLE_OFFLINE_QUEUE=false
REDIS_CLIENT_NAME=integrator-engine
ENABLED_ADAPTER_KEYS=
DISABLED_ADAPTER_KEYS=

INLINE_DELAY_THRESHOLD_MS=2000
SCHEDULED_WAIT_LEASE_MS=60000

# DEPLOY: Docker Compose + Traefik
# ROUTING: Traefik entrypoint (optional in Compose `proxy` profile)
# PROTOTYPE MODE SUPPORT: direct API access on :4000 keeps setup minimal.
# LIVE MODE SUPPORT: proxy profile routes API through Traefik hostnames.
TRAEFIK_WEB_HOST=localhost
TRAEFIK_API_HOST=api.localhost
TRAEFIK_WEB_PORT=80
TRAEFIK_DASHBOARD_PORT=8080

# Live registration inputs (platform-level only)
WEBHOOK_SIGNING_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/integrations
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/integrations
SLACK_BOT_TOKEN=

# Alert thresholds
ALERT_FAILURE_RATE_WARN=0.2
ALERT_DEAD_LETTER_RATE_WARN=0.05
ALERT_QUEUE_LAG_SECONDS_WARN=30
ALERT_CREDENTIAL_FAILURES_WARN=5

# Scale controls
SCALE_MAX_ACTIVE_WORKFLOW_RUNS_PER_WORKSPACE=50
SCALE_MAX_QUEUED_JOBS_PER_WORKSPACE=500
SCALE_MAX_SCHEDULED_WAITS_PER_WORKSPACE=1000
SCALE_MAX_WORKFLOWS_PER_WORKSPACE=250
SCALE_MAX_ACTIVE_RUNS_PER_WORKFLOW=10
SCALE_FAIRNESS_MAX_CONSECUTIVE_WORKSPACE_CLAIMS=5
SCALE_MAX_DEFER_ATTEMPTS=20
SCALE_ADAPTER_DEFAULT_RATE_LIMIT_PER_WINDOW=120
SCALE_ADAPTER_RATE_LIMIT_WINDOW_MS=60000
SCALE_ADAPTER_DEFAULT_CONCURRENCY=10
SCALE_QUEUE_BACKPRESSURE_WARNING_THRESHOLD=0.8

# Retention controls
RETENTION_WORKFLOW_RUNS_DAYS=30
RETENTION_EVENT_LOGS_DAYS=21
RETENTION_RETRY_RECORDS_DAYS=14
RETENTION_SCHEDULED_WAITS_DAYS=30
RETENTION_ALERT_LOGS_DAYS=30
RETENTION_AUDIT_LOGS_DAYS=90
RETENTION_CLEANUP_INTERVAL_SECONDS=300
RETENTION_CLEANUP_BATCH_SIZE=500
RETENTION_CLEANUP_MAX_BATCHES_PER_DOMAIN=20

