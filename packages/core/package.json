{
  "name": "@integration/core",
  "version": "1.0.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "create:adapter": "tsx src/tools/create-adapter.ts",
    "env:init": "tsx src/tools/init-env.ts",
    "setup:local": "tsx src/tools/setup-local.ts",
    "smoke:prototype": "tsx src/tools/local-smoke.ts --mode \"Prototype Mode\"",
    "smoke:live": "tsx src/tools/local-smoke.ts --mode \"Live Mode\"",
    "verify:setup": "tsx src/tools/verify-setup.ts",
    "migrate": "tsx src/migrations/run-migrations.ts",
    "seed": "tsx src/migrations/seed.ts",
    "reencrypt:credentials": "tsx src/security/reencrypt-credentials.ts"
  },
  "dependencies": {
    "@integration/adapter-email": "*",
    "@integration/adapter-shopify": "*",
    "@integration/adapter-sheets": "*",
    "@integration/adapter-slack": "*",
    "@integration/adapter-webhook": "*",
    "@integration/shared": "*",
    "ajv": "^8.17.1",
    "bullmq": "^5.61.0",
    "dotenv": "^17.2.3",
    "pg": "^8.16.3",
    "redis": "^4.7.1",
    "uuid": "^11.1.0"
  }
}

