APP_ENV=development

# Docker compose / database
POSTGRES_DB=integration
POSTGRES_USER=integration
POSTGRES_PASSWORD=integration
DATABASE_URL=postgres://integration:integration@postgres:5432/integration
REDIS_URL=redis://redis:6379

# API / Web
API_PORT=4000
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Webhook adapter
WEBHOOK_SIGNING_SECRET=dev-webhook-secret

# Google Sheets adapter
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/integrations/sheets/auth/callback

# Email adapter
EMAIL_SMTP_HOST=smtp.mailtrap.io
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM=no-reply@example.com

# Shopify adapter
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_SHOP_NAME=
SHOPIFY_ACCESS_TOKEN=

# Slack adapter
SLACK_BOT_TOKEN=
SLACK_DEFAULT_CHANNEL=#automation

