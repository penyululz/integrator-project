# Integration Platform API + Worker environment template
# Copy these values into a repository-root `.env` file before running local commands.

# ------------------------------------------------------------
# Required (all environments)
# ------------------------------------------------------------
APP_ENV=development
DATABASE_URL=postgres://integration:integration@localhost:5432/integration
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------
# Required in production (recommended in all environments)
# ------------------------------------------------------------
JWT_SECRET=change-me-before-production
MASTER_ENCRYPTION_KEY=replace-with-32-byte-hex-base64-or-raw-string
MASTER_ENCRYPTION_KEY_VERSION=1

# Optional previous keys for credential decryption during rotations:
# PREVIOUS_MASTER_ENCRYPTION_KEYS=1:<oldKeyBase64>,2:<olderKeyBase64>

# ------------------------------------------------------------
# Optional runtime configuration
# ------------------------------------------------------------
API_PORT=4000
JWT_EXPIRES_IN=12h
ADAPTER_MANIFESTS_DIR=
ENABLED_ADAPTER_KEYS=
DISABLED_ADAPTER_KEYS=

# Scheduler / durable wait tuning
INLINE_DELAY_THRESHOLD_MS=2000
SCHEDULED_WAIT_LEASE_MS=60000

# ------------------------------------------------------------
# Adapter configuration (set only what you use)
# ------------------------------------------------------------
WEBHOOK_SIGNING_SECRET=dev-webhook-secret

# Google Sheets (OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/integrations/sheets/auth/callback

# Email (SMTP)
EMAIL_SMTP_HOST=smtp.mailtrap.io
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM=no-reply@example.com

# Shopify
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_SHOP_NAME=
SHOPIFY_ACCESS_TOKEN=

# Slack
SLACK_BOT_TOKEN=
SLACK_DEFAULT_CHANNEL=#automation

# ------------------------------------------------------------
# Optional operations tuning
# ------------------------------------------------------------
# Alerting thresholds
ALERT_FAILURE_RATE_WARN=0.2
ALERT_DEAD_LETTER_RATE_WARN=0.05
ALERT_QUEUE_LAG_SECONDS_WARN=30
ALERT_CREDENTIAL_FAILURES_WARN=5

# Scale / fairness controls
SCALE_MAX_ACTIVE_WORKFLOW_RUNS_PER_WORKSPACE=50
SCALE_MAX_QUEUED_JOBS_PER_WORKSPACE=500
SCALE_MAX_SCHEDULED_WAITS_PER_WORKSPACE=1000
SCALE_MAX_WORKFLOWS_PER_WORKSPACE=250
SCALE_MAX_ACTIVE_RUNS_PER_WORKFLOW=10
SCALE_FAIRNESS_MAX_CONSECUTIVE_WORKSPACE_CLAIMS=5
SCALE_MAX_DEFER_ATTEMPTS=20
SCALE_ADAPTER_DEFAULT_RATE_LIMIT_PER_WINDOW=120
SCALE_ADAPTER_RATE_LIMIT_WINDOW_MS=60000
SCALE_ADAPTER_DEFAULT_CONCURRENCY=10
SCALE_QUEUE_BACKPRESSURE_WARNING_THRESHOLD=0.8
# SCALE_ADAPTER_LIMIT_OVERRIDES={"slack":{"maxActionsPerWindow":60,"windowMs":60000,"maxConcurrency":5}}

# Retention / cleanup
RETENTION_WORKFLOW_RUNS_DAYS=30
RETENTION_EVENT_LOGS_DAYS=21
RETENTION_RETRY_RECORDS_DAYS=14
RETENTION_SCHEDULED_WAITS_DAYS=30
RETENTION_ALERT_LOGS_DAYS=30
RETENTION_AUDIT_LOGS_DAYS=90
RETENTION_CLEANUP_INTERVAL_SECONDS=300
RETENTION_CLEANUP_BATCH_SIZE=500
RETENTION_CLEANUP_MAX_BATCHES_PER_DOMAIN=20

# ------------------------------------------------------------
# Dev/demo-only convenience
# ------------------------------------------------------------
# Dev login endpoint is enabled automatically when APP_ENV != production.
# Seed defaults after `npm run seed -w @integration/core`:
#   email=admin@example.com
#   password=dev-password
#   organizationSlug=demo-org
#   workspaceSlug=default
