# Integration Platform web app environment template
# Copy to `apps/web/.env.local` for local frontend development.
# STACK: React + TypeScript + Vite
# STATE: TanStack Query for server state, Zustand for local UI state
# BUILDER: React Flow / XYFlow
# MODE: Prototype Mode | Live Mode
# USED BY WEB

# REQUIRED FOR PROTOTYPE MODE AND LIVE MODE
VITE_INTEGRATOR_MODE="Prototype Mode"
# PROTOTYPE MODE SUPPORT: default direct API route.
# LIVE MODE SUPPORT: use `http://localhost/api/v1` when Traefik proxy profile is enabled.
VITE_API_BASE_URL=http://localhost:4000/api/v1

# OPTIONAL IN PROTOTYPE MODE / LIVE MODE
# Legacy compatibility fallback if VITE_INTEGRATOR_MODE is not set.
# VITE_APP_ENV=development
# VITE_APP_NAME=Integration Platform
# DEPLOY: Docker Compose + Traefik
# TRAEFIK_WEB_HOST=localhost
# TRAEFIK_API_HOST=api.localhost
